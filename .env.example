# ==============================================================================
# HealthTrack AI - Environment Configuration Template
# DO NOT commit your real .env file with actual API keys to GitHub!
# Copy this file to .env and insert your real credentials locally.
# ==============================================================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
DATABASE_PATH=data/healthtrack.db

# Optional LLM Fallback (100% Free Tiers)
# - Google Gemini API Free Tier (https://aistudio.google.com/app/apikey)
# - Or leave blank to use 100% free local deterministic regex parsing
GEMINI_API_KEY=

# Local Ollama endpoint (if using local offline vision/LLM, e.g. http://localhost:11434)
OLLAMA_HOST=http://localhost:11434
